<?xml version="1.0"?>
<sdf version="1.9">
  <world name="link_attacher_demo">
    <physics name="physics" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz_link_attacher_plugin" name="gz::sim::systems::GzLinkAttacher"/>

    <light name="sun" type="directional">
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <direction>-0.5 0.1 -0.9</direction>
    </light>
    <model name="ground_plane">
      <static>true</static>
      <link name="ground">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
        </visual>
      </link>
    </model>

    <!-- A small stand with a sliding tool link, anchored to the world. -->
    <model name="robot">
      <self_collide>true</self_collide>
      <link name="base">
        <inertial><mass>10</mass><inertia><ixx>1</ixx><iyy>1</iyy><izz>1</izz></inertia></inertial>
        <visual name="visual">
          <pose>0 0 1 0 0 0</pose>
          <geometry><box><size>0.1 0.1 2</size></box></geometry>
        </visual>
      </link>
      <link name="tool">
        <pose>0 0 2 0 0 0</pose>
        <gravity>false</gravity>
        <inertial><mass>1</mass><inertia><ixx>0.1</ixx><iyy>0.1</iyy><izz>0.1</izz></inertia></inertial>
        <visual name="visual">
          <geometry><box><size>0.2 0.2 0.2</size></box></geometry>
        </visual>
      </link>
      <joint name="anchor" type="fixed"><parent>world</parent><child>base</child></joint>
      <joint name="slide" type="prismatic">
        <parent>base</parent><child>tool</child>
        <axis>
          <xyz>1 0 0</xyz>
          <limit><lower>-5</lower><upper>5</upper><effort>1000</effort><velocity>1</velocity></limit>
        </axis>
      </joint>
    </model>
    <model name="object">
      <pose>0.4 0 2 0 0 0</pose>
      <link name="link">
        <inertial><mass>0.1</mass><inertia><ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz></inertia></inertial>
        <collision name="collision"><geometry><box><size>0.2 0.2 0.2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.2 0.2 0.2</size></box></geometry></visual>
      </link>
    </model>
    <!-- Deliberately named box_* to verify unrelated models retain physics. -->
    <model name="box_free">
      <pose>0.4 1 2 0 0 0</pose>
      <link name="link">
        <inertial><mass>0.1</mass><inertia><ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz></inertia></inertial>
        <collision name="collision"><geometry><box><size>0.2 0.2 0.2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.2 0.2 0.2</size></box></geometry></visual>
      </link>
    </model>
  </world>
</sdf>
